{
  "name": "ttdb",
  "version": "0.1.0",
  "type": "module",
  "description": "Blades in the Dark campaign companion — local editor + GitHub Pages static publisher",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:static": "VITE_STATIC_MODE=true vite build --outDir dist-static",
    "preview": "vite preview",
    "deploy": "node scripts/deploy-gh-pages.js",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@vueuse/core": "^10.9.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.12",
    "@types/node": "^20.12.5",
    "@vitejs/plugin-vue": "^5.0.4",
    "autoprefixer": "^10.4.19",
    "gh-pages": "^6.1.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.8",
    "vue-tsc": "^2.0.11"
  }
}
